# ── Kiwi Store frontend env (Vite) ────────────────────────────────────
# Sirf PUBLIC values dalna - secret KABHI nahi.
# Yeh variables Cloudflare Pages → Settings → Environment variables me bhi
# chalte hain (production + preview). Koi value na do to shared/brand.ts ka
# default chalega, isliye domain/name badalna = sirf yahan/Pages me change.

# Brand
VITE_APP_NAME=Kiwi Store
VITE_APP_SHORT_NAME=Kiwi
VITE_ECOSYSTEM_NAME=Gothwad

# Domains — zone badalna ho to sirf VITE_APP_DOMAIN badlo (chaaro sites
# https://<host>.<domain> se ban jaati hain):
VITE_APP_DOMAIN=gothwadtech.com
# VITE_STORE_HOST=kiwistore
# VITE_CONSOLE_HOST=kiwiconsole
# VITE_ADMIN_HOST=kiwiadmin
# VITE_STOREAPP_HOST=kiwiapp
# Kisi site ko poora URL dena ho (dusra zone / custom hostname):
# VITE_STORE_URL=https://kiwistore.gothwadtech.com
# VITE_CONSOLE_URL=https://kiwiconsole.gothwadtech.com
# VITE_ADMIN_URL=https://kiwiadmin.gothwadtech.com
# VITE_STOREAPP_URL=https://kiwiapp.gothwadtech.com

# Store ki apni Android app ka package (landing page isi listing ko dhoondhta hai)
VITE_STOREAPP_PACKAGE=com.gothwad.store

# Gothwad Accounts - alag service, iska naam/domain wahi rahega
VITE_ACCOUNTS_API_URL=https://accounts.gothwadtech.com/api
VITE_ACCOUNTS_SIGNIN_URL=https://accounts.gothwadtech.com
VITE_OAUTH_CLIENT_ID=kiwi-store

# Worker API (Pages par same-origin /api chalta hai)
VITE_API_BASE=/api
