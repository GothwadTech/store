# ═══════════════════════════════════════════════════════════════════
# Kiwi Store — Frontend + Build Environment Variables (.env.example)
#
# Sabhi defaults `shared/brand.ts` me set hain.
# Domain ya brand badalna ho to sirf niche ke variables set karein.
# ═══════════════════════════════════════════════════════════════════

# ── Brand & Domain ─────────────────────────────────────────────────
VITE_APP_NAME=Kiwi Store
VITE_APP_SHORT_NAME=Kiwi
VITE_ECOSYSTEM_NAME=Gothwad
VITE_APP_DOMAIN=gothwadtech.com
VITE_STOREAPP_PACKAGE=com.gothwad.store

# ── Subdomain Prefixes (`https://<host>.<VITE_APP_DOMAIN>`) ────────
VITE_STORE_HOST=kiwistore
VITE_CONSOLE_HOST=kiwiconsole
VITE_ADMIN_HOST=kiwiadmin
VITE_STOREAPP_HOST=kiwiapp

# ── API Base (same-origin Worker route `/api` ya local Wrangler) ───
VITE_API_BASE=/api

# ── Gothwad Accounts (OAuth 2.0 + PKCE + .gothwadtech.com SSO) ─────
VITE_ACCOUNTS_API_URL=https://api.gothwadtech.com
VITE_ACCOUNTS_SIGNIN_URL=https://accounts.gothwadtech.com
VITE_OAUTH_CLIENT_ID=kiwi-store
